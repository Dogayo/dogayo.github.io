---
// «Линза»: под фоном страницы лежат схемы остальных экранов проектов, а курсор на свободном месте открывает их маленьким кругом.
// Схемы — по правилам ProjectSketch.astro (NDA): холст 180×400, только плашки и фигуры в цветах темы.
// Каждая схема описана один раз как <symbol>, карточки ссылаются на неё через <use>, поэтому повторы почти ничего не стоят.
const sketches = [
	'exchange-trade',
	'sports-join',
	'car-radio',
	'fitness-challenge',
	'neobank-pin',
	'sports-bets',
	'jobs-map',
	'sports-predictions',
	'fitness-profile',
	'sports-leagues',
	'fitness-map',
	'sports-league',
] as const;

// Карточки разбросаны: поворот и сдвиг по вертикали зависят от номера, без случайности между сборками.
const cards = Array.from({ length: sketches.length * 6 }, (_, i) => ({
	sketch: sketches[i % sketches.length],
	rotate: [-5, 3, -2, 6, -4, 2, -6, 4][i % 8],
	shift: [0, 48, 16, 72, 32][i % 5],
}));

// Нижняя навигация из пяти пунктов, как в ProjectSketch.astro.
const tabs = [24, 57, 90, 123, 156];
// Метка на карте: капля с точкой.
const pin = (x: number, y: number) => `M${x} ${y}c-4-5-6-8-6-11a6 6 0 0 1 12 0c0 3-2 6-6 11z`;
// Строки стакана: ширина цены и глубина заявки.
const asks = [30, 26, 34, 22, 40, 28, 52, 36];
const bids = [44, 38, 26, 30, 50, 20, 24, 18];
---

<svg width="0" height="0" class="absolute" aria-hidden="true">
	<!-- Биржа: торговля со стаканом заявок -->
	<symbol id="lens-exchange-trade" viewBox="0 0 180 400">
		<rect x="12" y="27" width="20" height="5" rx="2" class="fill-text" />
		<rect x="12" y="37" width="20" height="2" rx="1" class="fill-accent" />
		<rect x="38" y="27" width="26" height="5" rx="2" class="fill-muted/40" />
		<rect x="150" y="25" width="20" height="10" rx="5" class="fill-accent" />
		<circle cx="165" cy="30" r="3.5" class="fill-on-accent" />
		<path d="M0 46h180" class="stroke-border" />
		<rect x="12.5" y="52.5" width="75" height="14" rx="7" class="fill-none stroke-border" />
		<rect x="38" y="57.5" width="24" height="4" rx="2" class="fill-muted/40" />
		<rect x="92.5" y="52.5" width="75" height="14" rx="7" class="fill-none stroke-accent" />
		<rect x="118" y="57.5" width="24" height="4" rx="2" class="fill-text/70" />
		<rect x="12" y="78" width="40" height="7" rx="2" class="fill-text" />
		<rect x="68" y="78" width="22" height="7" rx="3" class="fill-surface-2" />
		<rect x="132" y="77" width="36" height="5" rx="2" class="fill-text/70" />
		<path d="M0 96h180M94 96v256" class="stroke-border" />

		<!-- Форма ордера: покупка, лимит, цена, количество, ползунок, кнопка -->
		<rect x="8" y="104" width="80" height="14" rx="7" class="fill-surface-2" />
		<rect x="8" y="104" width="40" height="14" rx="7" class="fill-accent" />
		<rect x="20" y="109" width="16" height="4" rx="2" class="fill-on-accent/80" />
		<rect x="60" y="109" width="16" height="4" rx="2" class="fill-muted/40" />
		<rect x="8" y="124" width="80" height="12" rx="3" class="fill-accent-soft" />
		<rect x="14" y="128.5" width="56" height="3" rx="1.5" class="fill-accent/70" />
		{[146, 182, 200, 236].map((y, i) => (
			<g>
				<rect x="8.5" y={y + 0.5} width="79" height="13" rx="6.5" class="fill-none stroke-border" />
				<rect x="16" y={y + 5} width={i === 0 ? 20 : 18} height="4" rx="2" class={i === 0 ? 'fill-text/70' : 'fill-muted/40'} />
				{i > 0 && <rect x="68" y={y + 5} width="14" height="3" rx="1.5" class="fill-muted/40" />}
			</g>
		))}
		<path d="M76 151l3 3 3-3" class="fill-none stroke-text/70" stroke-width="1.2" />
		<rect x="8" y="168" width="40" height="3" rx="1.5" class="fill-muted/40" />
		<path d="M10 222h76" class="stroke-border" stroke-width="2" stroke-linecap="round" />
		<circle cx="10" cy="222" r="3" class="fill-accent" />
		<g class="fill-muted/40">
			{[8, 26, 44, 62, 78].map((x) => <rect x={x} y="228" width="8" height="2" rx="1" />)}
		</g>
		<rect x="8" y="256" width="80" height="16" rx="8" class="fill-surface-2" />
		<rect x="36" y="262" width="24" height="4" rx="2" class="fill-muted/40" />
		<rect x="18" y="282" width="40" height="3" rx="1.5" class="fill-muted/40" />
		<rect x="68" y="279" width="16" height="9" rx="4.5" class="fill-none stroke-border" />
		<circle cx="72.5" cy="283.5" r="2.5" class="fill-muted/40" />

