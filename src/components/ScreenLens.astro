<style>
	/* Радиус линзы анимируется, поэтому объявлен как типизированное свойство. */
	@property --lens-r {
		syntax: '<length>';
		inherits: true;
		initial-value: 0px;
	}

	/* Слой лежит за всем содержимым и виден только внутри круга вокруг курсора. Без мыши его нет. */
	.screen-lens {
		display: none;
	}

	@media (hover: hover) and (pointer: fine) {
		.screen-lens {
			display: block;
			position: fixed;
			inset: 0;
			z-index: -1;
			overflow: hidden;
			pointer-events: none;
			--lens-r: 0px;
			--lens-x: -100vw;
			--lens-y: -100vh;
			background: radial-gradient(circle at var(--lens-x) var(--lens-y), color-mix(in srgb, var(--accent) 8%, transparent), transparent var(--lens-r));
			mask-image: radial-gradient(circle at var(--lens-x) var(--lens-y), #000 calc(var(--lens-r) - 48px), transparent var(--lens-r));
			/* Схемы проступают сквозь фон, а не открываются целиком. */
			opacity: 0.5;
		}

		.screen-lens.is-open {
			--lens-r: 150px;
		}
	}

	@media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
		.screen-lens {
			transition: --lens-r 350ms ease-out;
		}
	}

	/* Карточки сеткой во всю ширину; при скролле едут вдвое медленнее страницы — кажется, что они глубже. */
	.screen-lens__cards {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 40px 56px;
		padding: 24px;
		translate: 0 calc(var(--lens-scroll, 0px) * -0.5);
	}
</style>

<script>
	// Линза открывается над свободным местом и закрывается над тем, что видно: текстом, картинками, ссылками,
	// блоками с фоном или рамкой. Невидимые обёртки разметки не в счёт. Положение и состояние обновляются раз в кадр.
	const layer = document.querySelector<HTMLElement>('[data-lens]');
	if (layer && matchMedia('(hover: hover) and (pointer: fine)').matches) {
		let x = 0;
		let y = 0;
		let inside = false;
		let frame = 0;
		const range = document.createRange();
		const transparent = (color: string) => color === 'transparent' || /rgba\(.*,\s*0\)$/.test(color);
		// Блок виден, если у него есть фон или рамка со всех сторон; одиночная линия-разделитель — нет.
		const visibleBox = (el: Element) => {
			const style = getComputedStyle(el);
			if (!transparent(style.backgroundColor) || style.backgroundImage !== 'none') return true;
			const sides = ['Top', 'Right', 'Bottom', 'Left'] as const;
			return sides.every((side) => parseFloat(style[`border${side}Width`]) > 0 && !transparent(style[`border${side}Color`]));
		};
		// Курсор над строкой текста, а не над пустым концом абзаца; небольшой запас вокруг букв.
		const overText = (el: Element) =>
			[...el.childNodes].some((node) => {
				if (node.nodeType !== Node.TEXT_NODE || !node.textContent?.trim()) return false;
				range.selectNodeContents(node);
				return [...range.getClientRects()].some((r) => x > r.left - 12 && x < r.right + 12 && y > r.top - 8 && y < r.bottom + 8);
			});
		const free = (hit: Element | null) => {
			if (!hit || overText(hit)) return false;
			for (let el: Element | null = hit; el && el !== document.body; el = el.parentElement) {
				if (el.matches('a, button, img, picture, svg, input, label, hr') || visibleBox(el)) return false;
			}
			return true;
		};
		const draw = () => {
			frame = 0;
			layer.style.setProperty('--lens-x', `${x}px`);
			layer.style.setProperty('--lens-y', `${y}px`);
			layer.style.setProperty('--lens-scroll', `${scrollY}px`);
			layer.classList.toggle('is-open', inside && free(document.elementFromPoint(x, y)));
		};
		const schedule = () => {
			frame ||= requestAnimationFrame(draw);
		};
		addEventListener(
			'pointermove',
			(event) => {
				if (event.pointerType !== 'mouse') return;
				x = event.clientX;
				y = event.clientY;
				inside = true;
				schedule();
			},
			{ passive: true },
		);
		addEventListener('scroll', schedule, { passive: true });
		document.documentElement.addEventListener('pointerleave', () => {
			inside = false;
			schedule();
		});
		schedule();
	}
</script>
