		{[[12, 64], [92, 64], [12, 190], [92, 190]].map(([x, y], i) => (
			<g>
				<rect x={x} y={y} width="76" height="120" rx="4" class="fill-surface-2" />
				<rect x={x + 6} y={y + 6} width="10" height="8" rx="2" class="fill-text" />
