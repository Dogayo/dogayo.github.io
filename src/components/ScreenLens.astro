		<rect x="150" y="120" width="22" height="3" rx="1.5" class="fill-muted/40" />
		{asks.map((depth, i) => (
			<g>
				<rect x={176 - depth} y={128 + i * 9} width={depth} height="8" class="fill-muted/15" />
				<rect x="100" y={130 + i * 9} width="26" height="4" rx="2" class="fill-muted/70" />
				<rect x="146" y={130 + i * 9} width="26" height="4" rx="2" class="fill-text/70" />
			</g>
		))}
		<rect x="100" y="206" width="34" height="7" rx="2" class="fill-text" />
		<rect x="100" y="217" width="16" height="3" rx="1.5" class="fill-muted/40" />
		{bids.map((depth, i) => (
			<g>
				<rect x={176 - depth} y={228 + i * 9} width={depth} height="8" class="fill-accent/15" />
				<rect x="100" y={230 + i * 9} width="26" height="4" rx="2" class="fill-accent" />
				<rect x="146" y={230 + i * 9} width="26" height="4" rx="2" class="fill-text/70" />
			</g>
		))}

		<path d="M0 352h180" class="stroke-border" />
		{tabs.map((x, i) => (
			<g class={i === 0 ? 'fill-accent' : 'fill-muted/40'}>
				<rect x={x - 6} y="360" width="12" height="12" rx="3" />
				<rect x={x - 9} y="376" width="18" height="3" rx="1.5" />
			</g>
		))}
	</symbol>

	<!-- Необанк: создание PIN-кода -->
	<symbol id="lens-neobank-pin" viewBox="0 0 180 400">
		<path d="M20 32h-8m3-3l-3 3 3 3" class="fill-none stroke-text/70" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
		<circle cx="90" cy="76" r="40" class="fill-accent/10" />
		<rect x="62" y="56" width="56" height="36" rx="5" class="fill-muted/25" />
		<path d="M84 92c6-14 18-26 34-32v32z" class="fill-accent/40" />
		<rect x="67" y="83" width="16" height="3" rx="1.5" class="fill-muted/60" />
		<circle cx="105" cy="85" r="2.5" class="fill-muted/60" />
		<circle cx="109" cy="85" r="2.5" class="fill-accent" />
