		<path d="M137 73l5 5m0-5l-5 5" class="stroke-text/70" stroke-width="1.2" stroke-linecap="round" />
		<path d="M156 71h12m-12 4.5h12m-12 4.5h12" class="stroke-text/70" stroke-width="1.5" stroke-linecap="round" />
		{[92, 178, 264].map((y, i) => (
			<g>
				<rect x="12" y={y} width="156" height="78" rx="6" class="fill-surface-2" />
				<rect x="20" y={y + 9} width="80" height="6" rx="2" class="fill-text" />
				<rect x="20" y={y + 20} width="6" height="4" rx="1" class={i === 1 ? 'fill-muted/60' : 'fill-accent'} />
				<rect x="29" y={y + 20} width="28" height="4" rx="2" class={i === 1 ? 'fill-muted/40' : 'fill-accent/70'} />
				<rect x="20" y={y + 30} width="44" height="10" rx="3" class="fill-bg" />
				<rect x="25" y={y + 33} width="30" height="4" rx="2" class="fill-text/70" />
				<circle cx="130" cy={y + 35} r="3" class="fill-muted/60" />
				<rect x="136" y={y + 33} width="24" height="4" rx="2" class="fill-text/70" />
				<rect x="20" y={y + 46} width="104" height="3" rx="1.5" class="fill-muted/40" />
				<rect x="20" y={y + 56} width="140" height="14" rx="4" class="fill-accent" />
				<rect x="76" y={y + 61} width="28" height="4" rx="2" class="fill-on-accent/80" />
			</g>
		))}
		<rect x="0" y="352" width="180" height="48" class="fill-bg" />
		<path d="M0 352h180" class="stroke-border" />
		{tabs.map((x, i) => (
			<g class={i === 4 ? 'fill-accent' : 'fill-muted/40'}>
				<rect x={x - 6} y="360" width="12" height="12" rx="3" />
				<rect x={x - 9} y="376" width="18" height="3" rx="1.5" />
			</g>
		))}
	</symbol>

	<!-- Спорт: ставки на подиум -->
	<symbol id="lens-sports-bets" viewBox="0 0 180 400">
		<rect x="74" y="29" width="32" height="7" rx="2" class="fill-text" />
		<circle cx="166" cy="32" r="4" class="fill-accent" />
		<rect x="12" y="50" width="44" height="6" rx="2" class="fill-text/70" />
		<path d="M60 50h6l2 3-5 4-5-4z" class="fill-accent" />
		<rect x="12" y="64" width="156" height="18" rx="4" class="fill-surface-2" />
		<rect x="20" y="71" width="40" height="4" rx="2" class="fill-text/70" />
