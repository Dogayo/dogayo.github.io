		<rect x="12" y="90" width="48" height="16" rx="5" class="fill-accent" />
		<rect x="24" y="96" width="24" height="4" rx="2" class="fill-on-accent/80" />
		<rect x="78" y="96" width="20" height="4" rx="2" class="fill-muted/40" />
		<rect x="128" y="96" width="28" height="4" rx="2" class="fill-muted/40" />
		<rect x="12" y="118" width="56" height="6" rx="2" class="fill-text" />
		{[134, 234].map((y) => (
			<g>
				<rect x="12" y={y + 2} width={y === 134 ? 18 : 36} height="5" rx="2" class="fill-text/70" />
				<circle cx={y === 134 ? 36 : 54} cy={y + 4.5} r="2.5" class="fill-none stroke-muted/60" />
				<rect x="106.5" y={y + 0.5} width="61" height="11" rx="2" class="fill-none stroke-border" />
				<rect x="114" y={y + 4} width="46" height="4" rx="2" class="fill-text/70" />
				<rect x="12.5" y={y + 18.5} width="75" height="11" rx="2" class="fill-none stroke-border" />
				<rect x="34" y={y + 22} width="32" height="4" rx="2" class="fill-muted/60" />
				<rect x="92" y={y + 18} width="76" height="12" rx="2" class="fill-accent" />
				<rect x="112" y={y + 22} width="36" height="4" rx="2" class="fill-on-accent/80" />
			</g>
		))}
		<rect x="12" y="174" width="156" height="48" rx="4" class="fill-surface-2" />
		<rect x="18" y="180" width="26" height="36" rx="3" class="fill-muted/40" />
		<rect x="56" y="186" width="40" height="4" rx="2" class="fill-text/70" />
		<rect x="58" y="194" width="36" height="3" rx="1.5" class="fill-muted/40" />
		<rect x="62" y="200" width="28" height="3" rx="1.5" class="fill-muted/40" />
		<rect x="132" y="181" width="28" height="7" rx="2" class="fill-accent-soft" />
		<rect x="128" y="194" width="32" height="4" rx="2" class="fill-text/70" />
