		<rect x="44" y="122" width="92" height="3" rx="1.5" class="fill-muted/40" />
		<rect x="62" y="129" width="56" height="3" rx="1.5" class="fill-muted/40" />
		{[40, 60, 80, 100, 120, 140].map((cx, i) => (
			<g>
				<circle cx={cx} cy="150" r="5" class={i < 3 ? 'fill-none stroke-accent' : 'fill-none stroke-border'} />
				{i < 4 && <circle cx={cx} cy="150" r="2" class={i < 3 ? 'fill-accent' : 'fill-text'} />}
			</g>
		))}
		{[246, 276, 306].map((y) =>
			[46, 90, 134].map((x) => <rect x={x - 3} y={y} width="6" height="9" rx="1.5" class="fill-text/70" />),
		)}
		<rect x="87" y="336" width="6" height="9" rx="1.5" class="fill-text/70" />
		<path d="M130 340.5l3-4h9v9h-9z" class="fill-none stroke-text/70" stroke-width="1.2" stroke-linejoin="round" />
	</symbol>

	<!-- Спорт: лиги с вкладками «вступить, создать, управлять» -->
	<symbol id="lens-sports-join" viewBox="0 0 180 400">
		<rect x="66" y="29" width="48" height="7" rx="2" class="fill-text" />
		<circle cx="166" cy="32" r="4" class="fill-accent" />
		<rect x="12" y="46" width="156" height="16" rx="5" class="fill-surface-2" />
		<rect x="12" y="46" width="52" height="16" rx="5" class="fill-accent" />
		<rect x="28" y="52" width="20" height="4" rx="2" class="fill-on-accent/80" />
		<rect x="80" y="52" width="24" height="4" rx="2" class="fill-muted/40" />
		<rect x="130" y="52" width="24" height="4" rx="2" class="fill-muted/40" />
