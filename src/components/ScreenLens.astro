		<rect x="20" y="92" width="6" height="4" rx="1" class="fill-accent" />
		<rect x="29" y="92" width="26" height="4" rx="2" class="fill-accent/70" />
		<circle cx="134" cy="94" r="3" class="fill-muted/60" />
		<rect x="140" y="92" width="20" height="4" rx="2" class="fill-text/70" />
		<g class="fill-muted/40">
			<rect x="20" y="104" width="136" height="3" rx="1.5" />
			<rect x="20" y="110" width="128" height="3" rx="1.5" />
			<rect x="20" y="116" width="60" height="3" rx="1.5" />
		</g>
		<rect x="20" y="132" width="140" height="18" rx="4" class="fill-accent" />
		<rect x="66" y="139" width="48" height="4" rx="2" class="fill-on-accent/80" />
		<rect x="12" y="172" width="110" height="6" rx="2" class="fill-text" />
		{[188, 276].map((y) => (
			<g>
				<rect x="12" y={y} width="156" height="80" rx="6" class="fill-surface-2" />
				<rect x="20" y={y + 9} width="76" height="6" rx="2" class="fill-text" />
				<rect x="20" y={y + 20} width="6" height="4" rx="1" class="fill-accent" />
				<rect x="29" y={y + 20} width="26" height="4" rx="2" class="fill-accent/70" />
				<rect x="20" y={y + 30} width="44" height="10" rx="3" class="fill-bg" />
				<rect x="25" y={y + 33} width="30" height="4" rx="2" class="fill-text/70" />
				<circle cx="134" cy={y + 35} r="3" class="fill-muted/60" />
				<rect x="140" y={y + 33} width="20" height="4" rx="2" class="fill-text/70" />
				<rect x="20" y={y + 48} width="120" height="3" rx="1.5" class="fill-muted/40" />
				<rect x="20" y={y + 58} width="140" height="14" rx="4" class="fill-accent" />
				<rect x="76" y={y + 63} width="28" height="4" rx="2" class="fill-on-accent/80" />
			</g>
		))}
		<rect x="0" y="352" width="180" height="48" class="fill-bg" />
		<path d="M0 352h180" class="stroke-border" />
		{tabs.map((x, i) => (
			<g class={i === 4 ? 'fill-accent' : 'fill-muted/40'}>
				<rect x={x - 6} y="360" width="12" height="12" rx="3" />
				<rect x={x - 9} y="376" width="18" height="3" rx="1.5" />
			</g>
		))}
	</symbol>

	<!-- Спорт: каталог лиг с поиском и фильтром -->
	<symbol id="lens-sports-leagues" viewBox="0 0 180 400">
		<path d="M18 29l-4 3.5 4 3.5" class="fill-none stroke-text/70" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
		<rect x="66" y="29" width="48" height="7" rx="2" class="fill-text" />
		<circle cx="166" cy="32" r="4" class="fill-accent" />
		<rect x="12" y="48" width="110" height="6" rx="2" class="fill-text" />
		<rect x="12" y="62" width="30" height="3" rx="1.5" class="fill-muted/40" />
		<rect x="12" y="69" width="136" height="14" rx="4" class="fill-surface-2" />
		<circle cx="21" cy="75.5" r="2.5" class="fill-none stroke-muted/60" stroke-width="1.2" />
