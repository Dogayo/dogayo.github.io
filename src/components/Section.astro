---
import SectionHeader from './SectionHeader.astro';

interface Props {
	id: string;
	index: string;
	title: string;
}

const { id, index, title } = Astro.props;
---

<section id={id} class="mx-auto flex max-w-[1072px] scroll-mt-16 flex-col md:scroll-mt-0 gap-6 px-4 pt-16 md:gap-8 md:pt-24">
	<SectionHeader index={index} title={title} />
	<slot />
</section>

<script>
	// Появление при скролле: заголовок и блоки раздела; у контейнеров с data-stagger — каждый дочерний элемент.
	// Элементы, попавшие на экран вместе, появляются по очереди с шагом 80ms.
	if (document.documentElement.classList.contains('reveal')) {
		const targets = [...document.querySelectorAll<HTMLElement>('main section[id] > *')].flatMap((el) =>
			el.hasAttribute('data-stagger') ? [...(el.children as HTMLCollectionOf<HTMLElement>)] : [el],
		);
		const reveal = (el: HTMLElement, i: number) => {
			el.style.setProperty('--reveal-delay', `${Math.min(i, 4) * 80}ms`);
			el.classList.add('is-visible');
			// Когда блок появился, правила появления снимаются — дальше работают его собственные переходы.
			const done = (event: TransitionEvent) => {
				if (event.target !== el) return;
				el.removeEventListener('transitionend', done);
				el.classList.replace('is-visible', 'revealed');
				el.style.removeProperty('--reveal-delay');
			};
			el.addEventListener('transitionend', done);
		};
		// Всё, что хоть краем видно при загрузке, появляется сразу: иначе блок у нижнего края ждёт первого скролла.
		const onScreen = targets.filter((el) => el.getBoundingClientRect().top < innerHeight);
		onScreen.forEach(reveal);
		const observer = new IntersectionObserver(
			(entries) => {
				entries
					.filter((entry) => entry.isIntersecting)
					.forEach((entry, i) => {
						reveal(entry.target as HTMLElement, i);
						observer.unobserve(entry.target);
					});
			},
			{ rootMargin: '0px 0px -10% 0px' },
		);
		for (const el of targets.filter((el) => !onScreen.includes(el))) observer.observe(el);
	}
</script>
