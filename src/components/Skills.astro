---
import type { Profile } from '../data/profile';
import Tag from './Tag.astro';

interface Props {
	profile: Profile;
}

const { profile } = Astro.props;
---

<div class="grid gap-6 md:grid-cols-2 md:gap-8">
	{profile.skills.map((group) => (
		<div class="flex flex-col gap-2.5">
			<h3 class="text-small font-medium">{group.title}</h3>
			<ul class="flex flex-wrap gap-1.5">
				{group.items.map((skill) => <Tag level={skill.level}>{skill.name}</Tag>)}
			</ul>
		</div>
	))}
</div>
<p class="flex flex-wrap items-center gap-x-4 gap-y-1 font-mono text-mono-s text-muted">
	<span class="inline-flex items-center gap-1.5"><span class="size-2.5 rounded-sm border border-accent bg-accent-soft"></span>{profile.ui.levels.expert}</span>
	<span class="inline-flex items-center gap-1.5"><span class="size-2.5 rounded-sm border border-border bg-surface-2"></span>{profile.ui.levels.intermediate}</span>
	<span class="inline-flex items-center gap-1.5 opacity-70"><span class="size-2.5 rounded-sm border border-border"></span>{profile.ui.levels.basic}</span>
</p>
