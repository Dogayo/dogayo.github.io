---
import type { Profile } from '../data/profile';

interface Props {
	profile: Profile;
}

const { profile } = Astro.props;
const { interests, learning, titles } = profile;
const label = 'text-caption font-medium uppercase text-muted';
---

<div class="grid gap-8 md:grid-cols-2">
	{interests.length > 0 && (
		<div class="flex flex-col gap-3">
			<h3 class={label}>{titles.interests}</h3>
			<ul class="flex flex-col gap-3">
				{interests.map((item) => (
					<li class="flex flex-col gap-0.5">
						<span class="text-small font-medium">{item.title}</span>
						<span class="text-small text-muted">{item.text}</span>
					</li>
				))}
			</ul>
		</div>
	)}

	<div class="flex flex-col gap-3">
		<h3 class={label}>{titles.learning}</h3>
		<ul class="flex flex-col gap-2">
			{learning.map((item) => (
				<li class="flex gap-2 text-small">
					<span class="font-mono text-accent" aria-hidden="true">→</span>
					<span>{item}</span>
				</li>
			))}
		</ul>
	</div>
</div>
