---
import { localePaths, type Locale, type Profile } from '../data/profile';
import ThemeToggle from './ThemeToggle.vue';

interface Props {
	profile: Profile;
	locale: Locale;
}

const { profile, locale } = Astro.props;
const { ui } = profile;

// sections — разделы, при которых пункт подсвечен: соседние разделы без своего пункта относятся к ближайшему.
const nav = [
	{ href: '#experience', label: ui.nav.experience, sections: ['experience'] },
	{ href: '#projects', label: ui.nav.projects, sections: ['projects', 'open-source'] },
	{ href: '#skills', label: ui.nav.skills, sections: ['skills', 'education', 'personal'] },
	{ href: '#contacts', label: ui.nav.contacts, sections: ['contacts'] },
];

const languages = Object.entries(localePaths) as [Locale, string][];
---

<header class="site-header sticky top-0 z-50 border-b border-border bg-bg/80 backdrop-blur-md">
	<div class="mx-auto flex max-w-[1072px] items-center justify-between gap-3 px-4 pt-4 pb-2 md:pb-4">
		<!-- На самых узких экранах (320px) логотип сокращается до «~/», иначе шапка не помещается. -->
		<a href={localePaths[locale]} aria-label="~/dogayo" data-logo class="font-mono text-mono text-text">~/<span class="max-[359px]:hidden">dogayo</span></a>
		<div class="flex items-center gap-2 sm:gap-3 md:gap-6">
			<nav aria-label={ui.navLabel} class="hidden gap-6 md:flex">
				{nav.map((item) => (
					<a
						href={item.href}
						data-spy={item.sections.join(' ')}
						class="font-mono text-mono-s text-muted transition-colors hover:text-accent aria-[current=location]:text-accent"
					>
						{item.label}
					</a>
				))}
			</nav>
			<nav aria-label={ui.language} class="flex items-center gap-0.5 rounded-full border border-border bg-surface-2 p-[3px]">
				{languages.map(([lang, path]) =>
					lang === locale ? (
						<span aria-current="page" class="rounded-full bg-surface px-2.5 py-1.5 font-mono sm:px-3 text-mono-s text-text">{lang}</span>
					) : (
						<a href={path} hreflang={lang} lang={lang} class="rounded-full px-2.5 py-1.5 font-mono sm:px-3 text-mono-s text-muted transition-colors hover:text-text">
							{lang}
						</a>
					),
				)}
			</nav>
			<ThemeToggle labels={ui.theme} client:load />
		</div>
	</div>
	<!-- На телефоне меню разделов — отдельной строкой под шапкой. -->
	<nav aria-label={ui.navLabel} class="mx-auto flex max-w-[1072px] justify-between px-4 pb-1.5 md:hidden">
		{nav.map((item) => (
			<a
				href={item.href}
				data-spy={item.sections.join(' ')}
				class="py-2 font-mono text-mono-s text-muted transition-colors hover:text-accent aria-[current=location]:text-accent"
			>
				{item.label}
			</a>
		))}
	</nav>
	<!-- Прогресс прочтения страницы по нижнему краю шапки (CSS scroll-driven animation). -->
	<div class="scroll-progress absolute inset-x-0 -bottom-px h-0.5 origin-left bg-accent" aria-hidden="true"></div>
</header>

<button
	type="button"
	data-back-to-top
	aria-label={ui.backToTop}
	title={ui.backToTop}
	inert
	class="fixed right-4 bottom-4 z-40 grid size-11 translate-y-2 place-items-center rounded-full border border-border bg-surface font-mono text-mono text-text opacity-0 transition duration-200 hover:border-accent hover:text-accent active:scale-[0.97] data-visible:translate-y-0 data-visible:opacity-100 md:right-6 md:bottom-6"
>
	<span aria-hidden="true">↑</span>
</button>

<script>
	// Подсветка пункта меню текущего раздела: текущий — последний раздел, чей верх прошёл под шапку.
	// Пункты меню есть и в десктопной, и в мобильной навигации — подсвечиваются все с тем же href.
	const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-spy]')];
	const header = document.querySelector('header');
	const sections = [
		...new Map(
			links.flatMap((link) =>
				link.dataset.spy!.split(' ').flatMap((id) => {
					const section = document.getElementById(id);
					return section ? [[id, { section, href: link.getAttribute('href') }] as const] : [];
				}),
			),
		).values(),
	];
	sections.sort((a, b) => a.section.offsetTop - b.section.offsetTop);

	let frame = 0;
	const update = () => {
		frame = 0;
		updateBackToTop();
		const line = (header?.offsetHeight ?? 0) + window.innerHeight * 0.25;
		const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
		let current: string | null | undefined;
		for (const { section, href } of sections) {
			if (section.getBoundingClientRect().top <= line) current = href;
		}
		// Последний раздел короткий и может не дойти до линии — внизу страницы подсвечиваем его.
		if (atBottom && sections.length) current = sections[sections.length - 1].href;
		for (const link of links) {
			if (link.getAttribute('href') === current) link.setAttribute('aria-current', 'location');
			else link.removeAttribute('aria-current');
		}
	};
	// Кнопка «наверх» появляется после первого экрана; фокус уходит на логотип, чтобы с клавиатуры продолжить сверху.
	const backToTop = document.querySelector<HTMLButtonElement>('[data-back-to-top]')!;
	const logo = document.querySelector<HTMLAnchorElement>('[data-logo]')!;
	const updateBackToTop = () => {
		const visible = window.scrollY > window.innerHeight;
		backToTop.toggleAttribute('data-visible', visible);
		backToTop.inert = !visible;
	};
	backToTop.addEventListener('click', () => {
		window.scrollTo({ top: 0 });
		logo.focus({ preventScroll: true });
	});

	const schedule = () => {
		if (!frame) frame = requestAnimationFrame(update);
	};

	addEventListener('scroll', schedule, { passive: true });
	addEventListener('resize', schedule);
	update();
</script>
