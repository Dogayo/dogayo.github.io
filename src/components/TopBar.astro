---
import ThemeToggle from './ThemeToggle.vue';

const nav = [
	{ href: '#experience', label: 'опыт' },
	{ href: '#projects', label: 'проекты' },
	{ href: '#skills', label: 'навыки' },
	{ href: '#contacts', label: 'контакты' },
];
---

<header class="border-b border-border">
	<div class="mx-auto flex max-w-[1072px] items-center justify-between px-4 py-4">
		<a href="/" class="font-mono text-mono text-text">~/dogayo</a>
		<div class="flex items-center gap-6">
			<nav aria-label="Разделы" class="hidden gap-6 md:flex">
				{nav.map((item) => (
					<a href={item.href} class="font-mono text-mono-s text-muted transition-colors hover:text-accent">
						{item.label}
					</a>
				))}
			</nav>
			<ThemeToggle client:load />
		</div>
	</div>
</header>
